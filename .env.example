# QIMEM API
QIMEM_API_HOST=0.0.0.0
QIMEM_API_PORT=8080

# Auth (optional)
QIMEM_AUTH_DISABLED=true
BETTER_AUTH_JWT_SECRET=change-me
BETTER_AUTH_ISSUER=https://your-better-auth-domain
BETTER_AUTH_AUDIENCE=qimem

# Policy controls
QIMEM_ALLOWED_COUNTRIES=US,CA,GB
QIMEM_REQUIRE_MFA=false
QIMEM_MFA_TOTP_SECRET=
