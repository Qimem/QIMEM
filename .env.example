# Optional runtime config
QIMEM_AUTH_JWT_SECRET=
QIMEM_MFA_TOTP_SECRET=
DATABASE_URL=

# API/Gateway server defaults
QIMEM__SERVER__HOST=127.0.0.1
QIMEM__SERVER__PORT=8080
QIMEM_GATEWAY_HOST=127.0.0.1
QIMEM_GATEWAY_PORT=8081

# Optional auth metadata (only needed when auth enabled)
QIMEM_AUTH_ISSUER=qimem
QIMEM_AUTH_AUDIENCE=qimem-users
QIMEM_AUTH_DISABLED=false

# Optional KMS/root key setup (only needed for KMS/gateway proxy routes)
QIMEM_ROOT_KEY_SOURCE=env
QIMEM_ROOT_KEY_B64=

# Optional root rotation toggle
QIMEM_ROOT_ROTATION_ENABLED=false
ENABLE_DESTRUCTIVE_ROTATION=false
QIMEM_ROOT_ROTATION_CONFIRMATION=

RUST_LOG=info
